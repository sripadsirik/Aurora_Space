{
  "name": "aurora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/normalize-cesium-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:mission": "vite-node scripts/validate-mission.ts",
    "format:mission": "prettier --write \"src/mission/**/*.{ts,json}\" \"src/components/mission/**/*.{tsx,css}\" \"e2e/*.ts\" playwright.config.ts scripts/validate-mission.ts",
    "test:e2e:aerospace": "playwright test --config playwright.aerospace.config.ts"
  },
  "dependencies": {
    "cesium": "^1.132.0",
    "hls.js": "^1.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^6.0.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-node": "^5.3.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
